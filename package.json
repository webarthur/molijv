{
  "name": "molijv",
  "version": "1.1.3",
  "description": "Mongoose-like JSON Schema Validator with Zod-inspired transformations",
  "main": "./dist/molijv.cjs",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --bail --verbose tests/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webarthur/molijv.git"
  },
  "keywords": [
    "JSON",
    "schema",
    "validator",
    "validation",
    "jsonschema",
    "json-schema",
    "json-schema-validator",
    "json-schema-validation",
    "mongoose",
    "mongoose-like",
    "zod-like",
    "schema-validation",
    "data-validation",
    "type-validation",
    "transform",
    "coercion"
  ],
  "exports": {
    "import": "./dist/molijv.mjs",
    "require": "./dist/molijv.cjs"
  },
  "author": "Arthur Ronconi <webarthur@gmail.com> (https://devarthur.com)",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "jest": "^29.7.0",
    "rollup": "^4.41.0"
  }
}
